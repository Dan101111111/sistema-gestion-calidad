# ============================================================
# SGC-UNT v2.0 — Variables de entorno
# Copiar como .env y ajustar para producción
# NUNCA commitear este archivo con valores reales
# ============================================================

# Entorno
NODE_ENV=development

# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_DB=sgcunt
POSTGRES_USER=sgc_user
POSTGRES_PASSWORD=sgc_secure_pass_2024
POSTGRES_PORT=5432

# ============================================================
# Redis
# ============================================================
REDIS_PASSWORD=redis_secure_2024
REDIS_PORT=6379

# ============================================================
# MinIO
# ============================================================
MINIO_ROOT_USER=sgc_minio_admin
MINIO_ROOT_PASSWORD=minio_secure_2024
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ============================================================
# JWT — CAMBIAR EN PRODUCCIÓN (mínimo 64 caracteres aleatorios)
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================================
JWT_SECRET=jwt_super_secret_sgc_unt_2024_CAMBIAR_EN_PRODUCCION_usar_64_chars_aleatorios
REFRESH_TOKEN_SECRET=refresh_super_secret_sgc_unt_2024_CAMBIAR_EN_PRODUCCION

# ============================================================
# HMAC para tokens de recuperación de contraseña
# ============================================================
HMAC_SECRET=hmac_secret_recovery_sgc_2024_CAMBIAR_EN_PRODUCCION

# ============================================================
# SMTP (correo saliente)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sgc@unitru.edu.pe
SMTP_PASS=tu_password_o_app_password
SMTP_FROM="SGC-UNT <sgc@unitru.edu.pe>"

# ============================================================
# n8n
# ============================================================
N8N_USER=sgc_n8n
N8N_PASSWORD=n8n_secure_2024
N8N_PORT=5678
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_API_KEY=n8n_api_key_2024_CAMBIAR
N8N_ENCRYPTION_KEY=n8n_encryption_key_2024_sgc_CAMBIAR

# ============================================================
# URLs Frontend
# ============================================================
FRONTEND_URL=http://localhost
NEXT_PUBLIC_API_URL=/api/v1
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:80
