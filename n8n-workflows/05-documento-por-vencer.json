    },
    {
      "parameters": {
        "url": "={{ $env.SGC_API_URL }}/api/v1/documentos?estado=aprobado&limit=200",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "name": "Obtener Docs Aprobados",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        -192,
        720
      ],
      "id": "e68e6242-e3a8-48ca-8fa3-c3afa25d337b",
      "credentials": {
        "httpHeaderAuth": {
          "id": "glvbxV4NdOJTZwYa",
          "name": "SGC-API-Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const hoy = new Date();\nconst limite = new Date(hoy);\nlimite.setDate(hoy.getDate() + 30);\n\nconst docs = $input.item.json.data || [];\nconst porVencer = docs.filter(d => {\n  if (!d.fecha_vigencia_fin) return false;\n  const fecha = new Date(d.fecha_vigencia_fin);\n  return fecha >= hoy && fecha <= limite;\n});\n\n// Agrupar por responsable\nconst porResponsable = {};\nporVencer.forEach(d => {\n  const rid = d.responsable_id || 'sin_responsable';\n  if (!porResponsable[rid]) porResponsable[rid] = { responsable: d.responsable, docs: [] };\n  porResponsable[rid].docs.push(d);\n});\n\nreturn Object.values(porResponsable).map(g => ({ json: g }));"
      },
      "name": "Filtrar y Agrupar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        720
      ],
      "id": "35bbfcff-4486-4ca2-bd54-599076538b60"
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.responsable }}",
              "rightValue": "",
              "operator": {
