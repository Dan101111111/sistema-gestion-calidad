{
  "name": "SGC - CAPA Vencida (Cron Diario)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1-5"
            }
          ]
        }
      },
      "name": "Cron Diario 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.SGC_API_URL }}/api/v1/capas?vencidas=true&limit=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "splitIntoItems": true,
          "itemProperty": "data"
        }
      },
      "name": "Obtener CAPAs Vencidas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "leftValue": "={{ $json.meta.total }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        },
        "options": {}
      },
      "name": "Hay CAPAs Vencidas?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.SGC_API_URL }}/api/v1/usuarios?rol=gestor_calidad&activo=true",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "splitIntoItems": true,
          "itemProperty": "data"
        }
      },
      "name": "Obtener Gestores",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM }}",
        "toEmail": "={{ $json.email }}",
        "subject": "=🔴 CAPAs Vencidas — Requieren Acción Inmediata — SGC-UNT",
        "emailType": "html",
        "options": {},
        "html": "=<!DOCTYPE html><html><head><style>body{font-family:Arial,sans-serif}.header{background:#C8102E;color:white;padding:20px}.body{background:white;padding:30px}table{width:100%;border-collapse:collapse}th{background:#003366;color:white;padding:8px;text-align:left}td{padding:8px;border-bottom:1px solid #eee}.footer{background:#f8f8f8;padding:15px;font-size:11px;color:#888;text-align:center}.btn{background:#003366;color:white;padding:10px 20px;text-decoration:none;border-radius:4px}</style></head><body><div class=\"header\"><h2>🔴 Reporte Diario: CAPAs Vencidas</h2></div><div class=\"body\"><p>Estimado/a Gestor de Calidad,</p><p>El reporte diario del SGC-UNT indica que existen <strong>{{ $('Obtener CAPAs Vencidas').first().json.meta.total }}</strong> CAPAs vencidas que requieren atención:</p><table><tr><th>Código</th><th>Descripción</th><th>Responsable</th><th>Venció</th><th>Estado</th></tr>{{ $('Obtener CAPAs Vencidas').first().json.data.slice(0,20).map(c => '<tr><td>'+c.codigo+'</td><td>'+c.descripcion.substring(0,60)+'...</td><td>'+(c.responsable ? c.responsable.nombre+' '+c.responsable.apellido : '-')+'</td><td>'+c.fecha_implementacion+'</td><td>'+c.estado+'</td></tr>').join('') }}</table>{{ $('Obtener CAPAs Vencidas').first().json.meta.total > 20 ? '<p><em>... y ' + ($('Obtener CAPAs Vencidas').first().json.meta.total - 20) + ' más. Ver reporte completo en el sistema.</em></p>' : '' }}<br><a href=\"{{ $env.FRONTEND_URL }}/capas?vencidas=true\" class=\"btn\">Ver CAPAs Vencidas</a></div><div class=\"footer\">SGC-UNT v2.0 · Reporte automático diario · Universidad Nacional de Trujillo</div></body></html>"
      },
      "name": "Email Reporte CAPAs",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        1120,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().flatMap(item => (item.json.data || []).map(x => ({ json: x })));"
      },
      "name": "Desempaquetar Gestores",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1010,
        200
      ]
    }
  ],
  "connections": {
    "Cron Diario 8am": {
      "main": [
        [
          {
            "node": "Obtener CAPAs Vencidas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Obtener CAPAs Vencidas": {
      "main": [
        [
          {
            "node": "Hay CAPAs Vencidas?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hay CAPAs Vencidas?": {
      "main": [
        [
          {
            "node": "Obtener Gestores",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Obtener Gestores": {
      "main": [
        [
          {
            "node": "Desempaquetar Gestores",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Desempaquetar Gestores": {
      "main": [
        [
          {
            "node": "Email Reporte CAPAs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1"
}