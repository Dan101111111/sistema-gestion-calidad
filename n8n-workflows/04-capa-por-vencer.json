    {
      "parameters": {
        "jsCode": "const hoy = new Date();\nconst limite = new Date(hoy);\nlimite.setDate(hoy.getDate() + 5);\n\nconst capas = $input.item.json.data || [];\nconst porVencer = capas.filter(c => {\n  if (['cerrada','rechazada'].includes(c.estado)) return false;\n  const fecha = new Date(c.fecha_implementacion);\n  return fecha >= hoy && fecha <= limite;\n});\n\nreturn porVencer.map(c => ({ json: c }));"
      },
